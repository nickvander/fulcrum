# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env
# backend/.env is gitignored and must never be committed — it holds live secrets.

# PostgreSQL
POSTGRES_USER=fulcrum
POSTGRES_PASSWORD=fulcrum  # template-ok: local-only default, matches docker-compose.yml
POSTGRES_DB=fulcrum
# Docker Compose resolves `db` / `redis` as service hostnames. Running the
# services natively instead? Point these at localhost and the ports you bound.
DATABASE_URL=postgresql://fulcrum:fulcrum@db:5432/fulcrum

# Redis
REDIS_URL=redis://redis:6379/0

# Signs JWTs. Generate your own — never reuse a key from any example or doc:
#   openssl rand -hex 32
# Rotating this invalidates every active session; users must sign in again.
SECRET_KEY=

# First Superuser — seeded on first boot. Change the password before any
# deployment reachable by anyone but you.
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=

# Encrypts marketplace tokens, SMTP passwords, and AI API keys at rest
# (AES-256-GCM). Must be a base64-encoded 32-byte key:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# WARNING: rotating this makes existing encrypted rows undecryptable. To rotate
# on a database with data, decrypt with the old key and re-encrypt with the new
# one — do not just swap the value.
MARKETPLACE_ENCRYPTION_KEY=

# MercadoLibre OAuth — from your app at https://developers.mercadolibre.com
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://your-domain.example/marketplaces/mercadolibre/callback

# --- FP-11 hardening (all default to current behavior when unset) ---
# CORS allow-list: comma-separated origins (e.g. the admin UI). Empty = no CORS.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
# Inbound-webhook shared secrets (anti-forgery) for marketplaces that don't sign
# their callbacks. Set, then configure the ML/Amazon callback URL to send it via
# the X-Webhook-Token header or ?token= query. (MercadoPago uses its own HMAC.)
ML_WEBHOOK_VERIFY_TOKEN=
AMAZON_WEBHOOK_VERIFY_TOKEN=
# Per-IP magic-link endpoint limit (slowapi syntax).
MAGIC_LINK_RATE_LIMIT=10/minute
